{
  "singleQuote": true,
  "jsxSingleQuote": false,
  "tabWidth": 2,
  "semi": false,
  "arrowParens": "avoid",
  "jsxBracketSameLine": false,
  "trailingComma": "none",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "react(.*)",
    "<THIRD_PARTY_MODULES>",
    "^./components/(.*)$",
    "^./*.*.scss",
    "^./types",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderCaseInsensitive": true,
  "overrides": [
    {
      "files": "**/*.scss",
      "options": {
        "singleQuote": false
      }
    }
  ],
  "proseWrap": "never",
  "bracketSpacing": true,
  "printWidth": 120,
  "quoteProps": "as-needed",
  "useTabs": false
}