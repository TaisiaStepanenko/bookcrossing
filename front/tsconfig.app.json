{
  "compilerOptions": {
    "types": ["vite/client", "jest", "@testing-library/jest-dom", "node"],
    "composite": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
  },
  "include": ["src"]
}